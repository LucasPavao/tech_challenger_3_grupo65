#Docker
COMPOSE_PROJECT_NAME=notificationservice

# Database (porta diferente do history-service para poder rodar os dois juntos)
POSTGRES_DB=notificationdb
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5433

# RabbitMQ (portas diferentes do history-service para teste isolado;
# ao integrar com o time, aponte para o broker compartilhado)
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5673
RABBITMQ_MANAGEMENT_PORT=15673
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_VHOST=/

# RabbitMQ - topologia (alinhar com appointment-service / Pessoa 4)
RABBITMQ_EXCHANGE=appointment.exchange
RABBITMQ_QUEUE=notification.queue
RABBITMQ_ROUTING_KEY=notification.created

# Spring
SPRING_PROFILES_ACTIVE=
SERVER_PORT=8081
