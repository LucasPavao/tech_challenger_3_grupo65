                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "pm.test('devolve os 10 campos', function () {",
                  "    const rows = pm.response.json().data.patientHistory;",
                  "    pm.expect(rows, 'publique os eventos primeiro').to.not.be.empty;",
                  "    pm.expect(Object.keys(rows[0])).to.have.members(['id','appointmentId','patientId',",
                  "        'patientName','doctorId','doctorName','description','appointmentDate',",
                  "        'eventStatus','occurredAt']);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "graphql",
              "graphql": {
                "query": "{\n  patientHistory(patientId: 10) {\n    id\n    appointmentId\n    patientId\n    patientName\n    doctorId\n    doctorName\n    description\n    appointmentDate\n    eventStatus\n    occurredAt\n  }\n}",
                "variables": ""
              }
            },
            "url": {
              "raw": "{{baseUrl}}/graphql",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "graphql"
              ]
            },
            "description": "Os 10 campos de MedicalRecord.\n\nCompare com a query 1: peca menos campos e a resposta encolhe. E a propriedade que justifica GraphQL aqui — o cliente escolhe o que trafega, sem endpoint novo."
          }
        },
        {
          "name": "4. Paciente sem historico — lista vazia, nao erro",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "pm.test('lista vazia, sem erro', function () {",
                  "    const body = pm.response.json();",
                  "    pm.expect(body.errors, 'nao deveria haver erro').to.be.undefined;",
                  "    pm.expect(body.data.patientHistory).to.eql([]);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "graphql",
              "graphql": {
                "query": "{\n  patientHistory(patientId: 999) {\n    appointmentId\n  }\n}",
                "variables": ""
              }
            },
            "url": {
              "raw": "{{baseUrl}}/graphql",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "graphql"
              ]
            },
            "description": "Decisao de design registrada: o history-service NAO conhece o cadastro de pacientes, entao nao consegue distinguir 'paciente inexistente' de 'paciente sem consultas'. Devolver NOT_FOUND seria afirmar algo que ele nao sabe."
          }
        },
        {
          "name": "5. Id nao numerico — BAD_REQUEST",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('classificado como BAD_REQUEST', function () {",
                  "    const errs = pm.response.json().errors;",
                  "    pm.expect(errs, 'deveria haver erro').to.not.be.undefined;",
                  "    pm.expect(errs[0].extensions.classification).to.eql('BAD_REQUEST');",
                  "});",
                  "pm.test('a mensagem nao vaza internals', function () {",
                  "    const msg = pm.response.json().errors[0].message;",
                  "    pm.expect(msg).to.not.match(/Exception|\\bat [a-z]+\\./);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "graphql",
              "graphql": {
                "query": "{\n  patientHistory(patientId: \"abc\") {\n    appointmentId\n  }\n}",
                "variables": ""
              }
            },
            "url": {
              "raw": "{{baseUrl}}/graphql",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "graphql"
              ]
            },
            "description": "O tipo ID! do GraphQL aceita qualquer string, entao o erro so aparece na conversao para Long. Sem tratamento isso viraria INTERNAL_ERROR opaco com stack trace no log — um caller nao autenticado poderia inundar o log de ERROR com uma query malformada."
          }
        }
      ]
    }
  ]
}
