# Profile do Compose. Sem isso, `docker compose up` sobe so o banco.
COMPOSE_PROFILES=apps

# Banco proprio deste servico
POSTGRES_DB=history_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432

# Aplicacao
SERVER_PORT=8081
GRAPHIQL_ENABLED=true

# Topologia RabbitMQ — CONTRATO COMPARTILHADO com appointment-service
# appointment.exchange é o exchange único usado por todos os serviços
RABBITMQ_EXCHANGE=appointment.exchange
RABBITMQ_QUEUE=history.queue
RABBITMQ_ROUTING_KEY=history.created
